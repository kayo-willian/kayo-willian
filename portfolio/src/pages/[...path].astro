---
import Home from '../components/Home.astro';
import Archive from '../components/Archive.astro';
import {catalog,type Lang} from '../lib/site';
export function getStaticPaths(){
 return [
  {params:{path:'pt-br'},props:{lang:'pt',section:null}},
  ...catalog.sections.flatMap(s=>[
   {params:{path:s.id},props:{lang:'en',section:s.id}},
   {params:{path:'pt-br/'+s.id},props:{lang:'pt',section:s.id}}
  ])
 ];
}
const {lang,section}=Astro.props as {lang:Lang;section:string|null};
---
{section ? <Archive lang={lang} section={section}/> : <Home lang={lang}/>}
