---
import Layout from './Layout.astro';
import ProjectGrid from './ProjectGrid.astro';
import {catalog,projects,root,url,social,t,type Lang} from '../lib/site';
const {lang,section} = Astro.props as {lang:Lang;section:string};
const s=catalog.sections.find(s=>s.id===section)!;
const names:Record<string,string[]> = {
 sound:[...catalog.music.artists,...catalog.music.goats],
 seinen:catalog.seinen, heretics:catalog.comics.map(x=>x.includes(' / ')? x.split(' / ')[lang==='en'?1:0]:x),
 games:catalog.games, underground:[...catalog.screen,'Tsurugi Linux','GNU/Linux','Unix',t(lang,'Independent web','Internet independente')],
 freedom:['GNU/Linux','Open Source',t(lang,'Free software','Software livre')],
 origins:[t(lang,'Brazil','Brasil'),t(lang,'Amazon','Amazônia'),'Santarém — Pará'],
 earth:[t(lang,'Amazon rivers','Rios amazônicos'),t(lang,'Forests','Florestas'),t(lang,'Geography','Geografia')],
 machines:['GNU/Linux','Hardware',t(lang,'Servers','Servidores'),t(lang,'Imaginary machines','Máquinas imaginárias')],
 aesthetics:[t(lang,'Japanese typography','Tipografia japonesa'),t(lang,'Analog and digital art','Arte analógica e digital'),'Manga',t(lang,'Afrofuturism','Afrofuturismo')],
 'black-culture':[t(lang,'Black culture','Cultura negra'),t(lang,'Music','Música'),t(lang,'Afrofuturism','Afrofuturismo')]
};
const statuses:Record<string,string>={read:t(lang,'Read','Lido'),abandoned:t(lang,'Abandoned','Abandonado'),uncertain:t(lang,'Maybe','Talvez'),unspecified:t(lang,'Unspecified','Não informado')};
---
<Layout lang={lang} title={s.title} section={section}>
<div class="wrap archive-page"><a class="back" href={url(lang)+'#archive'}>← {t(lang,'Back to archive','Voltar ao arquivo')}</a><header class="section-heading"><div><span class="japanese" lang="ja">{s.ja}</span><h1>{s.title}<span>.</span></h1><p>{s.description[lang]}</p></div></header>
{section==='projects' && <ProjectGrid lang={lang} slugs={projects.map(p=>p.slug)}/>}
{section==='goats' && <div class="goat-pair">{catalog.music.goats.map(n=><div>{n}</div>)}</div>}
{section==='fight' && <ul class="fighters">{catalog.fighters.map(f=><li class:list={[{featured:f.featured}]}><small>{f.name}</small><strong>{f.label}</strong><span>{f.sport.toUpperCase()}</span></li>)}</ul>}
{section==='library' && <><h2>TOP 05</h2><ol class="ranking">{catalog.library.ranking.map(b=><li>{b}</li>)}</ol><div class="table-wrap"><table><thead><tr>{[t(lang,'Book','Livro'),t(lang,'Author','Autor'),t(lang,'Status','Estado'),t(lang,'Rating','Nota')].map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{catalog.library.books.map(b=><tr><th scope="row">{b.title}</th><td>{b.author}</td><td>{statuses[b.status]}</td><td>{b.rating===null?'—':b.rating+'/10'}</td></tr>)}</tbody></table></div></>}
{section==='underground' && <figure class="archive-image"><img src={root+'images/header-blue.jpg'} alt="Tsurugi Linux artwork"/><figcaption>Tsurugi Linux / OSINT</figcaption></figure>}
{names[section] && <ul class="names">{names[section].map(n=><li>{n}</li>)}</ul>}
{section==='connection' && <ul class="names">{social.map(s=><li><a href={s.href}>{s.label} ↗</a></li>)}</ul>}
{section==='existence' && <p>Kayo Willian — GNU/Linux, Open Source, Hardware &amp; Software.</p>}
{section==='experiments' && <svg class="experiment" viewBox="0 0 500 220" role="img" aria-label={t(lang,'Geometric experiment','Experimento geométrico')}><g fill="none" stroke="currentColor">{Array.from({length:15},(_,i)=><ellipse cx="250" cy="110" rx={30+i*13} ry={25+i*5} transform={'rotate('+i*12+' 250 110)'}/>)}</g></svg>}
{section==='memory' && <p>{t(lang,'A space for future records.','Um espaço para registros futuros.')}</p>}
</div>
</Layout>
