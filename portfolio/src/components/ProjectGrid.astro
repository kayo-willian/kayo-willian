---
import { projects, t, type Lang } from '../lib/site';
const {lang,slugs} = Astro.props as {lang:Lang;slugs:string[]};
const items = slugs.map(slug=>projects.find(p=>p.slug===slug)!);
---
<div class:list={['work-grid', items.length === 6 ? 'six' : 'even']}>
{items.map((p,i)=><article class="work-card">
<div class="card-top"><span>{p.fork ? t(lang,'Fork / contribution','Fork / contribuição') : t(lang,p.en,p.pt)}</span><span class="card-number">{String(i+1).padStart(2,'0')}</span></div>
<h3>{p.title}</h3><p class="description">{p.details[lang === 'en' ? 1 : 0]}</p>
<div class="card-bottom"><p>{p.details[2]}</p><a href={'https://github.com/kayo-willian/'+p.slug} aria-label={'GitHub — '+p.title}>GitHub ↗</a></div>
</article>)}
</div>
