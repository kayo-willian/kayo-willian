---
import Layout from './Layout.astro';
import ProjectGrid from './ProjectGrid.astro';
import Quote from './Quote.astro';
import {catalog,groups,social,root,url,t,type Lang} from '../lib/site';
const {lang} = Astro.props as {lang:Lang};
const personal = catalog.sections.filter(s=>!['projects','existence','connection'].includes(s.id));
---
<Layout lang={lang} title="Kayo Willian">
<section class="hero wrap" aria-labelledby="name">
<div class="hero-copy"><p class="eyebrow"><span class="signal"></span> {t(lang,'BRAZIL / AMAZON','BRASIL / AMAZÔNIA')}</p>
<p class="japanese" lang="ja">ゴー・ビヨンド</p>
<h1 id="name">Kayo<br/>Willian<span>.</span></h1>
<p class="role">GNU/Linux <span>/</span> {t(lang,'Networking','Redes')} <span>/</span> Open Source</p>
<p class="intro">{t(lang,'I build and test software and hardware, explore Linux systems, networking and infrastructure, and document what I learn along the way.','Construo e testo software e hardware, exploro sistemas Linux, redes e infraestrutura e documento o que aprendo pelo caminho.')}</p>
<div class="hero-actions"><a class="primary" href="#work">{t(lang,'Explore my work','Explorar meus projetos')} ↓</a>{social.map(s=><a class="social" href={s.href}>{s.label} ↗</a>)}</div>
</div>
<figure class="hero-visual"><img src={root+'images/header-blue.jpg'} alt={t(lang,'Blue-toned Tsurugi Linux swordsman artwork','Arte em azul do espadachim do Tsurugi Linux')} fetchpriority="high"/><figcaption><span lang="ja">剣 / TSURUGI</span><span>{t(lang,'Visual reference','Referência visual')} / OSINT</span></figcaption></figure>
</section>
<div class="wrap">
<Quote lang={lang} index={0} theme={t(lang,'CHOOSING A PATH','ESCOLHER UM CAMINHO')}/>
<section class="profile-strip"><span lang="ja">存在</span><div><small>{t(lang,'ECOSYSTEM','ECOSSISTEMA')}</small><strong>GNU/Linux</strong></div><div><small>{t(lang,'INTERESTS','INTERESSES')}</small><strong>Hardware &amp; Software</strong></div><div><small>{t(lang,'ACTIVITIES','ATIVIDADES')}</small><strong>{t(lang,'Testing & Research','Testes e pesquisa')}</strong></div></section>
{groups.map((g,i)=><section id={g.id} class="work-section"><div class="section-heading"><div><span class="eyebrow">0{i+1} / <span lang="ja">{g.ja}</span></span><h2>{t(lang,g.en,g.pt)}<span>.</span></h2></div><span class="count">{String(g.slugs.length).padStart(2,'0')}</span></div><ProjectGrid lang={lang} slugs={g.slugs}/>{g.id==='labs' && <Quote lang={lang} index={1} theme={t(lang,'LEARNING','APRENDER')}/>}</section>)}
<Quote lang={lang} index={2} theme={t(lang,'TRYING AGAIN','TENTAR NOVAMENTE')}/>
<section id="archive" class="personal-archive"><div class="section-heading"><div><span class="eyebrow" lang="ja">記憶</span><h2>{t(lang,'Personal archive','Arquivo pessoal')}<span>.</span></h2></div></div><p>{t(lang,'The things I read, listen to, watch and return to.','As coisas que leio, ouço, acompanho e revisito.')}</p>
<ul class="archive-links">{personal.map(s=><li><a href={url(lang,s.id)}><span lang="ja">{s.ja}</span><span>{s.title}</span><span aria-hidden="true">↗</span></a></li>)}</ul>
</section>
<Quote lang={lang} index={3} theme={t(lang,'GO BEYOND','IR ALÉM')}/>
</div>
</Layout>
